<!--index.wxml-->
<view class="page {{orient}}">
  <view class="rot-fab {{orient}}" bindtap="onRotate">{{rotLabel}}</view>

  <!-- 头部：年月 + 切换 -->
  <view class="head">
    <view class="head-nav">
      <button class="arrow" hover-class="none" bindtap="prevMonth" disabled="{{!canPrev}}">‹</button>
      <picker mode="date" value="{{curYmd}}" start="{{pickStart}}" end="{{pickEnd}}" bindchange="datePickerBindchange">
        <view class="head-label">
          <text class="ym">{{curLabel}}</text>
          <text class="caret">▾</text>
        </view>
      </picker>
      <button class="arrow" hover-class="none" bindtap="nextMonth" disabled="{{!canNext}}">›</button>
    </view>
    <view class="head-today" bindtap="today">{{todayLabel}}</view>
  </view>

  <!-- 月份滑动视图 -->
  <swiper class="cal-swiper" style="height:{{swiperH}}px" current="{{swiperIndex}}" duration="220"
          bindchange="onSwiperChange">
    <block wx:for="{{pages}}" wx:key="label" wx:for-item="pg">
      <swiper-item>
        <view class="month-card">
          <view class="tib">{{pg.tib}}</view>
          <view class="table">
            <view class="tr head">
              <view class="th">日</view>
              <view class="th">一</view>
              <view class="th">二</view>
              <view class="th">三</view>
              <view class="th">四</view>
              <view class="th">五</view>
              <view class="th">六</view>
            </view>
            <block wx:for="{{pg.rows}}" wx:for-item="row" wx:for-index="ri">
              <view class="tr" style="{{orient === 'horizontal' && rowH ? 'height:' + rowH + 'px' : ''}}">
                <view wx:for="{{row}}" wx:for-item="cell" wx:key="index" class="{{cell.cls}}">
                  <text class="top">{{cell.top}}</text>
                  <text class="sub">{{cell.sub}}</text>
                  <text class="main">{{cell.main}}</text>
                </view>
              </view>
            </block>
          </view>
        </view>
      </swiper-item>
    </block>
  </swiper>

  <!-- 本月要事 -->
  <view class="events" wx:if="{{pages.length && pages[1].extra}}">
    <text class="events-title">本月要事</text>
    <text class="events-body">{{pages[1].extra}}</text>
  </view>
  <view class="tip">左右滑动切换月份 · 点顶部 ‹ › 或点右上角切换横屏大日历</view>
</view>
