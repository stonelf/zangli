page {
  background: #faf7f0;
}
.page {
  padding: 20rpx 20rpx 30rpx;
  box-sizing: border-box;
}
/* 旋转悬浮按钮（横/竖方向随状态反向） */
.rot-fab {
  position: fixed;
  right: 20rpx;
  top: 16rpx;
  z-index: 50;
  width: 132rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: #fff;
  background: rgba(139, 0, 0, .88);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, .18);
  letter-spacing: 1rpx;
}
.rot-fab.horizontal { background: rgba(184, 134, 11, .92); }

/* 头部 */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 12rpx 14rpx;
  box-shadow: 0 6rpx 24rpx rgba(120, 90, 20, .07);
  margin-top: 8rpx;
}
.head-nav { display: flex; align-items: center; gap: 8rpx; flex: 1; }
.arrow {
  width: 84rpx;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  margin: 0;
  background: #f6efe0;
  color: #b8860b;
  font-size: 52rpx;
  border-radius: 16rpx;
}
.arrow::after { border: none; }
.arrow[disabled] { color: #d9d2c2; background: #f3f0e8; }
.head-label { flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.head-label .ym { font-size: 38rpx; font-weight: 600; color: #6b5b2f; }
.caret { font-size: 24rpx; color: #b8860b; }
.head-today {
  font-size: 26rpx;
  color: #b8860b;
  border: 1rpx solid #e3c983;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
}

/* 滑动区（高度由 JS 依据方向计算） */
.cal-swiper { margin-top: 18rpx; }
.month-card {
  background: #fff;
  border-radius: 22rpx;
  padding: 14rpx 12rpx 16rpx;
  box-shadow: 0 6rpx 24rpx rgba(120, 90, 20, .07);
  box-sizing: border-box;
  height: 100%;
  display: flex;
  flex-direction: column;
}
.tib {
  text-align: center;
  color: #8a6d2f;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

/* 日历表：行在可用高度内均分，格内信息自适应 */
.table { flex: 1; display: flex; flex-direction: column; }
.tr { flex: 1; display: flex; min-height: 0; }
.tr.head .th { color: #a99c85; font-weight: 600; }
.th {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  line-height: 2.6;
  align-self: center;
}
.td {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: auto;
  margin: 2rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.td.blank { visibility: hidden; }
.td .top {
  font-size: 22rpx;
  color: #b3ab9a;
  line-height: 1.15;
  height: 26rpx;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
}
.td .sub {
  font-size: 22rpx;
  color: #c0392b;
  line-height: 1.15;
  height: 26rpx;
  white-space: nowrap;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}
.td .main {
  font-size: 34rpx;
  color: #3a3a35;
  line-height: 1.4;
  max-width: 100%;
  overflow: hidden;
}
.td.today {
  background: #b8860b;
  border-radius: 16rpx;
}
.td.today .top, .td.today .sub, .td.today .main { color: #fff; }
.td.today .sub { color: #ffe9a8; }
.td.solar-eclipse { background: #fdeaea; }
.td.lunar-eclipse { background: #eef2fb; }
.td.solar-eclipse .main, .td.lunar-eclipse .main { color: #7a2e1d; }

/* 要事与提示 */
.events {
  margin-top: 18rpx;
  background: #fff7e6;
  border: 1rpx solid #eedcb3;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
}
.events-title {
  font-size: 26rpx;
  color: #b8860b;
  display: block;
  margin-bottom: 6rpx;
}
.events-body {
  font-size: 24rpx;
  color: #7a6a4a;
  line-height: 1.7;
  white-space: pre-wrap;
}
.tip {
  margin-top: 14rpx;
  text-align: center;
  color: #b3ab9a;
  font-size: 24rpx;
}

/* ============ 横版（重力横屏） ============
 * 说明：auto 横屏时 windowWidth 变大，rpx 基准会随宽度放大，
 * 故横版统一改用 px 控制字号/尺寸，避免叠加放大导致溢出。 */
.page.horizontal { padding: 6px 10px; }
.page.horizontal .head {
  padding: 4px 8px;
  border-radius: 12px;
  margin-top: 0;
}
.page.horizontal .head-nav { gap: 4px; }
.page.horizontal .arrow {
  width: 42px; height: 42px; line-height: 42px;
  font-size: 28px; border-radius: 10px;
}
.page.horizontal .head-label .ym { font-size: 20px; }
.page.horizontal .caret { font-size: 13px; }
.page.horizontal .head-today { font-size: 13px; padding: 3px 12px; border-radius: 20px; }
.page.horizontal .cal-swiper { margin-top: 6px; }
.page.horizontal .month-card { padding: 3px 5px; border-radius: 14px; }
.page.horizontal .tib { font-size: 13px; margin-bottom: 2px; }
.page.horizontal .th { font-size: 11px; line-height: 2; }
.page.horizontal .td { margin: 1px; border-radius: 8px; }
.page.horizontal .td .top { font-size: 10px; height: 13px; line-height: 1.2; }
.page.horizontal .td .sub { font-size: 10px; height: 13px; line-height: 1.2; }
.page.horizontal .td .main { font-size: 19px; line-height: 1.25; }
.page.horizontal .events,
.page.horizontal .tip { display: none; }
